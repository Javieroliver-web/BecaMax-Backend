{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/bdns/process_cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/alerts/process_cron",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/difusion/process_cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/boletin/process_cron",
      "schedule": "0 9 * * 1"
    }
  ]
}
